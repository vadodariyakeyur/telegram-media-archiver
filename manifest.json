{
  "manifest_version": 3,
  "name": "Telegram Media Archiver",
  "version": "1.0",
  "description": "Archives photos, videos and other media from the Telegram Web chat you have open.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_title": "Telegram Media Archiver"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "src/page/fetch-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "src/vendor/jszip.min.js",
        "src/content/00-namespace.js",
        "src/content/05-run.js",
        "src/content/10-dom.js",
        "src/content/15-theme.js",
        "src/content/20-classify.js",
        "src/content/30-bridge.js",
        "src/content/40-viewer.js",
        "src/content/50-scan.js",
        "src/content/60-locate.js",
        "src/content/70-collect.js",
        "src/content/80-archive.js",
        "src/content/90-session.js",
        "src/content/99-main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
